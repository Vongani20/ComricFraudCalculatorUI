# Local only — leave false (or omit) for Azure-hosted builds that use Microsoft login.
VITE_USE_DEV_AUTH=false

# Microsoft Entra (SPA / public client)
VITE_AZURE_TENANT_ID=your-entra-tenant-id
VITE_AZURE_CLIENT_ID=your-spa-or-api-app-client-id

# Prefer a comma-separated list of API scopes for the portal:
VITE_AZURE_API_SCOPES=api://your-api-client-id/Events.Read,api://your-api-client-id/Events.Write,api://your-api-client-id/Signals.Read,api://your-api-client-id/Audit.Read,api://your-api-client-id/Dashboard.Read

# Or a single scope / space-separated list:
# VITE_AZURE_API_SCOPE=api://your-api-client-id/Dashboard.Read
